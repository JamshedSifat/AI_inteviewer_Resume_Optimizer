# # Copy this file to `.env` and fill in values as needed.
# # Nothing here is required for the default local-first pipeline:
# # Ollama (local, free) is tried first, so the app works with an empty .env
# # as long as `ollama serve` is running with a model pulled (e.g. llama3.2:3b).

# # --- Ollama (local, free, primary) ---
# # Base URL for a local or self-hosted Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# # --- OpenRouter (cloud, free-tier fallback) ---
# # Get a free key at https://openrouter.ai/keys
# # Only needed if Ollama is unavailable and you want the cloud fallback.
# OPENROUTER_API_KEY=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

# # Optional: only set these if you want to re-enable the paid providers
# # as an additional (non-default) fallback. Not required by the app.
